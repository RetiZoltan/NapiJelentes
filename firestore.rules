rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMainAdmin() {
      return isAuth() && getUser().isMainAdmin == true;
    }

    function getRole() {
      let u = getUser();
      return get(/databases/$(database)/documents/roles/$(u.roleId)).data;
    }

    function hasPerm(p) {
      let u = getUser();
      return isMainAdmin() || (
        u.get('roleId', null) != null &&
        get(/databases/$(database)/documents/roles/$(u.roleId)).data.permissions[p] == true
      );
    }

    // ── users ──────────────────────────────────────────────────
    match /users/{uid} {
      // Mindenki olvashatja a saját profilját; főadmin + felh.kezelő mindenkit
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        isMainAdmin() ||
        hasPerm('felhasznalokKezelese')
      );
      // Saját user-dokumentum létrehozása (regisztrációkor)
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.isMainAdmin == false;
      // Főadmin frissíthet bármit; user a saját profilját (de isMainAdmin-t nem)
      allow update: if isAuth() && (
        isMainAdmin() ||
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['isMainAdmin','roleId']))
      );
      allow delete: if isAuth() && isMainAdmin();
    }

    // ── roles ──────────────────────────────────────────────────
    match /roles/{roleId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isMainAdmin();
    }

    // ── entries ────────────────────────────────────────────────
    match /entries/{entryId} {
      allow read: if isAuth() && (
        isMainAdmin() ||
        hasPerm('mindenJelentes') ||
        (hasPerm('sajatJelentes') && resource.data.createdBy == request.auth.uid)
      );
      allow create: if isAuth() && hasPerm('adatbevitel');
      allow update: if isAuth() && (
        isMainAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAuth() && (
        isMainAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // ── dailyNotes ─────────────────────────────────────────────
    match /dailyNotes/{date} {
      allow read: if isAuth() && (
        isMainAdmin() ||
        hasPerm('mindenJelentes') ||
        hasPerm('sajatJelentes')
      );
      allow write: if isAuth() && (
        isMainAdmin() ||
        hasPerm('adatbevitel')
      );
    }

    // ── config/notice (közlemény — csak admin írhat) ──────────
    match /config/notice {
      allow read:  if isAuth();
      allow write: if isAuth() && (
        isMainAdmin() ||
        hasPerm('felhasznalokKezelese')
      );
    }

// ── config/premiumConfig (csak prémium kezelő írhat) ───────
    match /config/premiumConfig {
      allow read:  if isAuth();
      allow write: if isAuth() && (
        isMainAdmin() ||
        hasPerm('premiumKezeles')
      );
    }

    // ── employees ──────────────────────────────────────────────
    match /employees/{empId} {
      allow read: if isAuth() && (
        isMainAdmin() ||
        hasPerm('dolgozokMegtekintes') ||
        hasPerm('dolgozokKezeles')
      );
      allow write: if isAuth() && (
        isMainAdmin() ||
        hasPerm('dolgozokKezeles')
      );
    }

    // ── absences ───────────────────────────────────────────────
    match /absences/{absId} {
      allow read: if isAuth() && (
        isMainAdmin() ||
        hasPerm('dolgozokMegtekintes') ||
        hasPerm('dolgozokKezeles')
      );
      allow write: if isAuth() && (
        isMainAdmin() ||
        hasPerm('dolgozokKezeles')
      );
    }

    // ── notices (közlemények) ──────────────────────────────────
    match /notices/{noticeId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isMainAdmin() || hasPerm('kozlemenyIras') || hasPerm('felhasznalokKezelese')
      );
      allow update: if isAuth() && (
        isMainAdmin() ||
        hasPerm('kozlemenyIras') ||
        hasPerm('felhasznalokKezelese') ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
      allow delete: if isAuth() && (
        isMainAdmin() || hasPerm('kozlemenyIras') || hasPerm('felhasznalokKezelese')
      );
    }

    // ── tasks (feladatok) ──────────────────────────────────────
    match /tasks/{taskId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isMainAdmin() || hasPerm('feladatokKezeles'));
      allow update: if isAuth() && (
        isMainAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid
      );
      allow delete: if isAuth() && (isMainAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // ── machines (gépek) ──────────────────────────────────────
    match /machines/{id} {
      allow read:   if isAuth() && (isMainAdmin() || hasPerm('gepekMegtekintes') || hasPerm('gepekKezeles'));
      allow create: if isAuth() && (isMainAdmin() || hasPerm('gepekKezeles'));
      allow update: if isAuth() && (isMainAdmin() || hasPerm('gepekKezeles'));
      allow delete: if isAuth() && isMainAdmin();
    }
    match /machineEvents/{id} {
      allow read:   if isAuth() && (isMainAdmin() || hasPerm('gepekMegtekintes') || hasPerm('gepekKezeles'));
      allow create: if isAuth() && (isMainAdmin() || hasPerm('gepekKezeles'));
      allow delete: if isAuth() && (isMainAdmin() || hasPerm('gepekKezeles'));
      allow update: if false;
    }

    // ── stockLocations (raktárak, helyszínek) ─────────────────
    match /stockLocations/{id} {
      allow read:   if isAuth() && (isMainAdmin() || hasPerm('keszletMegtekintes') || hasPerm('keszletKezeles'));
      allow create: if isAuth() && (isMainAdmin() || hasPerm('keszletKezeles'));
      allow update: if isAuth() && (isMainAdmin() || hasPerm('keszletKezeles'));
      allow delete: if isAuth() && isMainAdmin();
    }

    // ── stockMovements (anyagmozgások) ─────────────────────────
    match /stockMovements/{id} {
      allow read:   if isAuth() && (isMainAdmin() || hasPerm('keszletMegtekintes') || hasPerm('keszletKezeles'));
      allow create: if isAuth() && (isMainAdmin() || hasPerm('keszletKezeles'));
      allow delete: if isAuth() && (isMainAdmin() || hasPerm('keszletKezeles'));
      allow update: if false;
    }

    // ── premiumHistory (prémium előzmények) ───────────────────
    match /premiumHistory/{id} {
      allow read:   if isAuth() && (isMainAdmin() || hasPerm('premiumMegtekintes') || hasPerm('premiumKezeles'));
      allow create: if isAuth() && (isMainAdmin() || hasPerm('premiumKezeles'));
      allow delete: if isAuth() && (isMainAdmin() || hasPerm('premiumKezeles'));
      allow update: if false;
    }

    // ── overtimes (túlóra) ────────────────────────────────────
    match /overtimes/{id} {
      allow read: if isAuth() && (
        isMainAdmin() || hasPerm('dolgozokMegtekintes') || hasPerm('dolgozokKezeles')
      );
      allow create: if isAuth() && (isMainAdmin() || hasPerm('dolgozokKezeles'));
      allow delete: if isAuth() && (isMainAdmin() || hasPerm('dolgozokKezeles'));
      allow update: if false;
    }

    // ── auditLog (audit napló) ─────────────────────────────────
    match /auditLog/{logId} {
      allow read:   if isAuth() && isMainAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ── config (nevek/anyagok/gépek listák) ────────────────────
    match /config/{doc} {
      allow read:  if isAuth();
      allow write: if isAuth() && (
        isMainAdmin() ||
        hasPerm('adatbevitel')
      );
    }
  }
}
